<UserControl
    x:Class="v2rayN.Desktop.Views.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:v2rayN.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:DashboardViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <!--  Power switch: quiet grey disc when off, green with a soft glow when on.  -->
        <Style Selector="Button.power">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource MacControlBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MacText2}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        x:Name="disc"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource MacCardBorder}"
                        BorderThickness="1"
                        CornerRadius="34">
                        <c:LineIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            Data="{DynamicResource I.Power}"
                            Foreground="{TemplateBinding Foreground}"
                            StrokeThickness="2.2" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.power:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.power:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
        </Style>
        <Style Selector="Button.power.on">
            <Setter Property="Background" Value="{DynamicResource MacGreen}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.power.on /template/ Border#disc">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="0 6 18 -4 #8034C759" />
        </Style>

        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource MacGray}" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="{DynamicResource MacGreen}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,4,28,28" Spacing="14">

            <!--  Connection hero  -->
            <Border Padding="20,18" Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="btnPower" Classes="power" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,12,0"
                        VerticalAlignment="Center"
                        Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="dotState" Classes="dot" />
                            <TextBlock
                                x:Name="txtState"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource MacText0}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MacText0}"
                            Text="{Binding ServerName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding CurrentServer}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Classes="pill accent"
                                IsVisible="{Binding ServerType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ServerType}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="caption"
                                Text="{Binding ServerEndpoint}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Classes="caption"
                            Text="{x:Static resx:ResUI.MacDashLatency}"
                            ToolTip.Tip="{x:Static resx:ResUI.MacDashLatencyHint}" />
                        <Border
                            x:Name="pillLatency"
                            Padding="10,3"
                            HorizontalAlignment="Right"
                            Classes="pill">
                            <TextBlock
                                x:Name="txtLatency"
                                FontSize="15"
                                Text="{Binding LatencyDisplay}" />
                        </Border>
                        <Button
                            x:Name="btnTest"
                            HorizontalAlignment="Right"
                            Classes="link"
                            Command="{Binding TestLatencyCmd}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <c:LineIcon
                                    Width="12"
                                    Height="12"
                                    Data="{DynamicResource I.Zap}" />
                                <TextBlock x:Name="txtTest" Text="{x:Static resx:ResUI.MacDashTestLatency}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Traffic  -->
            <Border Padding="16,14,16,12" Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="sectionTitle"
                            Text="{x:Static resx:ResUI.MacDashTraffic}" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,18,0"
                            IsVisible="{Binding SpeedEnabled}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <c:LineIcon
                                Width="13"
                                Height="13"
                                Data="{DynamicResource I.ArrowUp}"
                                Foreground="{DynamicResource MacChartUp}"
                                StrokeThickness="2.4" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="caption"
                                Text="{x:Static resx:ResUI.MacDashUp}" />
                            <TextBlock
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Classes="body"
                                FontFeatures="+tnum"
                                FontWeight="SemiBold"
                                Text="{Binding UpSpeedDisplay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            IsVisible="{Binding SpeedEnabled}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <c:LineIcon
                                Width="13"
                                Height="13"
                                Data="{DynamicResource I.ArrowDown}"
                                Foreground="{DynamicResource MacChartDown}"
                                StrokeThickness="2.4" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="caption"
                                Text="{x:Static resx:ResUI.MacDashDown}" />
                            <TextBlock
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Classes="body"
                                FontFeatures="+tnum"
                                FontWeight="SemiBold"
                                Text="{Binding DownSpeedDisplay}" />
                        </StackPanel>
                    </Grid>

                    <Panel Grid.Row="1" Height="112" Margin="0,12,0,0">
                        <c:TrafficChart
                            x:Name="chart"
                            DownBrush="{DynamicResource MacChartDown}"
                            GridBrush="{DynamicResource MacHairline}"
                            UpBrush="{DynamicResource MacChartUp}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !SpeedEnabled}"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="caption"
                                Text="{x:Static resx:ResUI.MacDashSpeedOff}" />
                            <Button
                                Classes="tool primary"
                                Command="{Binding EnableSpeedCmd}"
                                Content="{x:Static resx:ResUI.MacDashSpeedEnable}" />
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!--  Proxy behaviour  -->
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                        <Border Background="{DynamicResource MacAccent}" Classes="rowIcon">
                            <c:LineIcon Data="{DynamicResource I.Monitor}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Classes="rowLabel"
                            Text="{x:Static resx:ResUI.MacDashSystemProxy}" />
                        <ListBox
                            Grid.Column="2"
                            Classes="segmented"
                            SelectedIndex="{Binding StatusBar.SystemProxySelected, Mode=TwoWay}">
                            <ListBoxItem Content="{x:Static resx:ResUI.MacProxyOff}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.MacProxyOn}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.MacProxyKeep}" />
                            <ListBoxItem Content="{x:Static resx:ResUI.MacProxyPac}" IsVisible="{Binding StatusBar.BlSystemProxyPacVisible}" />
                        </ListBox>
                    </Grid>
                    <Border Margin="48,0,0,0" Classes="hairline" />
                    <Grid
                        Classes="row"
                        ColumnDefinitions="Auto,*,Auto"
                        IsVisible="{Binding StatusBar.BlRouting}">
                        <Border Background="{DynamicResource MacOrange}" Classes="rowIcon">
                            <c:LineIcon Data="{DynamicResource I.Route}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Classes="rowLabel"
                            Text="{x:Static resx:ResUI.MacDashRouting}" />
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            DisplayMemberBinding="{Binding Remarks}"
                            ItemsSource="{Binding StatusBar.RoutingItems}"
                            SelectedItem="{Binding StatusBar.SelectedRouting, Mode=TwoWay}" />
                    </Grid>
                    <Border
                        Margin="48,0,0,0"
                        Classes="hairline"
                        IsVisible="{Binding StatusBar.BlRouting}" />
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                        <Border Background="#AF52DE" Classes="rowIcon">
                            <c:LineIcon Data="{DynamicResource I.Shield}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Classes="rowLabel"
                            Text="{x:Static resx:ResUI.MacTrayTunMode}" />
                        <ToggleSwitch
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsChecked="{Binding TunOn}"
                            Theme="{DynamicResource SimpleToggleSwitch}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Local endpoint and core  -->
            <Border Classes="card">
                <StackPanel>
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Background="{DynamicResource MacGray}" Classes="rowIcon">
                            <c:LineIcon Data="{DynamicResource I.Plug}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Classes="rowLabel"
                            Text="{x:Static resx:ResUI.MacDashListening}" />
                        <SelectableTextBlock
                            Grid.Column="2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="Menlo, SF Mono, monospace"
                            FontSize="12"
                            Foreground="{DynamicResource MacText1}"
                            Text="{Binding LocalPortDisplay}" />
                        <Button
                            Grid.Column="3"
                            Classes="link"
                            Command="{Binding StatusBar.CopyProxyCmdToClipboardCmd}"
                            ToolTip.Tip="{x:Static resx:ResUI.MacDashCopyProxyCmd}">
                            <c:LineIcon
                                Width="14"
                                Height="14"
                                Data="{DynamicResource I.Copy}" />
                        </Button>
                    </Grid>
                    <Border Margin="48,0,0,0" Classes="hairline" />
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Background="{DynamicResource MacGreen}" Classes="rowIcon">
                            <c:LineIcon Data="{DynamicResource I.Cpu}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Classes="rowLabel"
                            Text="{x:Static resx:ResUI.MacDashCore}" />
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Ellipse x:Name="dotCore" Classes="dot" />
                            <TextBlock
                                x:Name="txtCore"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource MacText1}" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Classes="tool"
                            Command="{Binding ReloadCmd}"
                            Content="{x:Static resx:ResUI.MacDashReload}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
